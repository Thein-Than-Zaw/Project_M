# Documentation only: Spring does not automatically load .env.
# Use scripts/start-local.ps1 or export these variables yourself.
DB_URL=jdbc:postgresql://127.0.0.1:5432/couple_private_space
DB_USERNAME=couple_app
DB_PASSWORD=<set-a-local-random-password>
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
# Local HTTP only. A future HTTPS environment must set true.
SESSION_COOKIE_SECURE=false
TEST_DB_URL=jdbc:postgresql://127.0.0.1:5432/couple_private_space_test
REGISTRATION_TOKEN_HOURS=24
LOGIN_ACCOUNT_LIMIT=10
LOGIN_IP_LIMIT=30
REGISTRATION_IP_LIMIT=10
AUTH_RATE_WINDOW_SECONDS=900
MEMORY_STORAGE_ROOT=.local/uploads
FFPROBE_PATH=.tools/ffmpeg/ffmpeg-8.1.2-essentials_build/bin/ffprobe.exe
FFMPEG_PATH=.tools/ffmpeg/ffmpeg-8.1.2-essentials_build/bin/ffmpeg.exe
# Optional relay; keep the shared secret server-side, never in JavaScript.
TURN_URLS=
STUN_URLS=
TURN_SHARED_SECRET=
# Alternative managed TURN credentials; do not also set TURN_SHARED_SECRET.
TURN_USERNAME=
TURN_PASSWORD=
# Optional Neon launcher inputs; use real URLs only in ignored .env.local.
# DATABASE_URL=postgresql://ROLE:PASSWORD@POOLED_HOST/neondb?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql://ROLE:PASSWORD@DIRECT_HOST/neondb?sslmode=require
# NEON_MEMORY_STORAGE_ROOT=.local/neon-uploads
# HOST-01 hosted private media (actual values only in ignored env / Render secrets)
# AWS_ENDPOINT_URL_S3=https://YOUR_BRANCH_STORAGE_ENDPOINT
# AWS_REGION=us-east-2
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# MEMORY_S3_BUCKET=couple-memories
# Render injects PORT and RENDER_EXTERNAL_URL. Optional custom HTTPS origin:
# APP_PUBLIC_ORIGIN=https://YOUR_APP.onrender.com
